# Private key for deployment.
# For local Anvil development, you can use the default account #0:
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# For Flare Coston2, use your own funded wallet key. Never commit a real key.
PRIVATE_KEY=your_private_key_here

# Flare Coston2 RPCs
# For production traffic, prefer a dedicated QuickNode, NOWNodes, or Ankr endpoint.
# ChainList chain 114 lists additional public RPCs.
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
FLARE_COSTON2_RPC=https://coston2.enosys.global/ext/C/rpc
CHAIN_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Flare FTSOv2 / registry configuration.
FTSO_NATIVE_USD_FEED_ID=0x01464c522f55534400000000000000000000000000
FTSO_ETH_USD_FEED_ID=0x014554482f55534400000000000000000000000000

# Optional explorer verification key if you configure automated source verification.
ETHERSCAN_API_KEY=

# Optional mock Aave/local-yield deployment settings.
MOCK_AAVE_ASSET=0x0000000000000000000000000000000000000000
MOCK_AAVE_WRAP_NATIVE=false
MOCK_AAVE_ATOKEN_NAME=Mock Aave interest bearing token
MOCK_AAVE_ATOKEN_SYMBOL=maToken
MOCK_AAVE_LIQUIDITY_RATE=0

# Flare Confidential Compute / FDC demo configuration.
# Must match the value used by the agent when signing TEE-attested decisions.
FCE_IMAGE_HASH=0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069
AGENT_WALLET_ADDRESS=
# Official Flare FCC extension stack. Fill from Flare Coston2 FCC deployed-addresses.json / extension setup.
TEE_EXTENSION_REGISTRY_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
TEE_MACHINE_REGISTRY_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
FCC_INSTRUCTION_SENDER_ADDRESS=0x6Aa62B3979D4cdc6E3A84772d66dC45adA047CaB
FCC_EXT_PROXY_URL=
EXT_PROXY_URL=
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
LOCAL_MODE=false
SIMULATED_TEE=true
# Flare official protocol registry. Same address on Flare, Coston2, Songbird, and Coston.
FLARE_CONTRACT_REGISTRY_ADDRESS=0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019
TEE_EXTENSION_REGISTRY_NAME=TeeExtensionRegistry
TEE_MACHINE_REGISTRY_NAME=TeeMachineRegistry
FLARE_TEE_MANAGER_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
MOCK_FDC_VERIFIER_ADDRESS=0x4FE685b35c3A1B9b297eF7D1465C49b5d859daE9