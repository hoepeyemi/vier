# vier app environment
NEXT_PUBLIC_NETWORK_MODE=testnet
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_APP_URL=http://localhost:3000
GITHUB_PAGES=false

# Flare Coston2 RPCs
# Use a dedicated QuickNode, NOWNodes, or Ankr endpoint for production traffic.
# Public fallbacks: Flare public RPC and Enosys. ChainList chain 114 lists additional public RPCs.
NEXT_PUBLIC_COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_FLARE_COSTON2_RPC=https://coston2.enosys.global/ext/C/rpc
NEXT_PUBLIC_CHAIN_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Optional mainnet RPC overrides, used only when NEXT_PUBLIC_NETWORK_MODE=mainnet.
NEXT_PUBLIC_ETH_RPC=
NEXT_PUBLIC_BSC_RPC=
NEXT_PUBLIC_BASE_RPC=
NEXT_PUBLIC_ARBITRUM_RPC=
NEXT_PUBLIC_POLYGON_RPC=
NEXT_PUBLIC_FLARE_RPC=https://flare-api.flare.network/ext/C/rpc

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Agent WebSocket
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8080

# Deployed on Flare Coston2. Fill from contracts/deployments/coston2.json after deployment.
NEXT_PUBLIC_COSTON2_INVOICE_NFT=0x7481aeE59C35bb08c4F4B0DC4DE0C0A143c9d7b7
NEXT_PUBLIC_COSTON2_YIELD_VAULT=0xfDa39D8a75391aAec43BB54a774bf6F03A0033b6
NEXT_PUBLIC_COSTON2_AGENT_ROUTER=0x95116249980028E240403477E41dF44e12968AC5
NEXT_PUBLIC_COSTON2_PRIVACY_REGISTRY=0xc08B41ACeD118665d08b9517c812db483245791C
NEXT_PUBLIC_COSTON2_FTSO_V2=0xC4e9c78EA53db782E28f28Fdf80BaF59336B304d
NEXT_PUBLIC_COSTON2_FTSO_ORACLE=0xCc351f611b89607e25ab124D3abF58A83ADf94a9
NEXT_PUBLIC_COSTON2_AAVE_YIELD_SOURCE=0xfDa39D8a75391aAec43BB54a774bf6F03A0033b6

# Local Anvil/dev address overrides, used only for local chain ID 31337.
NEXT_PUBLIC_INVOICE_NFT_ADDRESS=
NEXT_PUBLIC_YIELD_VAULT_ADDRESS=
NEXT_PUBLIC_AGENT_ROUTER_ADDRESS=
NEXT_PUBLIC_PRIVACY_REGISTRY_ADDRESS=

# Optional QuickBooks integration.
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# Server-side FCC mint attestation API. In production this is injected into the FCE/TEE runtime.
FLARE_FCE_IDENTITY_KEY=
FLARE_TEE_ID=
FCE_IMAGE_HASH=0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069
FLARE_CHAIN_ID=114
# Official Flare FCC extension stack. Fill from Flare Coston2 FCC deployed-addresses.json / extension setup.
TEE_EXTENSION_REGISTRY_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
TEE_MACHINE_REGISTRY_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
FCC_INSTRUCTION_SENDER_ADDRESS=0x6Aa62B3979D4cdc6E3A84772d66dC45adA047CaB
FCC_EXT_PROXY_URL=
EXT_PROXY_URL=
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
LOCAL_MODE=false
SIMULATED_TEE=true
# Flare official protocol registry. Same address on Flare, Coston2, Songbird, and Coston.
FLARE_CONTRACT_REGISTRY_ADDRESS=0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019
TEE_EXTENSION_REGISTRY_NAME=TeeExtensionRegistry
TEE_MACHINE_REGISTRY_NAME=TeeMachineRegistry
FLARE_TEE_MANAGER_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
NEXT_PUBLIC_COSTON2_MOCK_FDC_VERIFIER=0x4FE685b35c3A1B9b297eF7D1465C49b5d859daE9