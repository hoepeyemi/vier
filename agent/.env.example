# vier Agent - Environment Configuration
# Copy this file to .env and fill in your values.

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

DEPLOYMENT_NETWORK=coston2
CHAIN_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
FLARE_COSTON2_RPC=https://coston2.enosys.global/ext/C/rpc
RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Agent wallet private key (required for executing transactions)
# WARNING: Never commit real private keys to version control.
AGENT_PRIVATE_KEY=

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# Qwen API key (for AI explanations)
# Qwen DashScope-compatible API configuration
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MAX_MODEL=qwen-max
QWEN_TURBO_MODEL=qwen-turbo
QWEN_EMBED_MODEL=text-embedding-v2
QWEN_MAX_TOKENS=300
QWEN_TIMEOUT_MS=30000
QWEN_MAINTENANCE_TIMEOUT_MS=20000
QWEN_MAX_CALLS_PER_MINUTE=30

# WebSocket server port
WS_PORT=8080

# WebSocket authentication token (optional; leave empty for development)
WS_AUTH_TOKEN=

# =============================================================================
# CONTRACT ADDRESSES - FLARE COSTON2 (Chain ID: 114)
# =============================================================================

# The agent auto-loads deployed addresses from contracts/deployments/coston2.json.
# Use these only when deploying the agent without the manifest file available.
INVOICE_NFT_ADDRESS=0x0000000000000000000000000000000000000000
YIELD_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
PRIVACY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
MOCK_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
PYTH_ORACLE_ADDRESS=
AAVE_YIELD_ADDRESS=

# =============================================================================
# FLARE CONFIDENTIAL COMPUTE / FDC
# =============================================================================

FCE_TEE_MODE=true
FLARE_CHAIN_ID=114
FLARE_TEE_ID=
FLARE_FCE_IDENTITY_KEY=
FCE_IMAGE_HASH=0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069