# vier Agent - Environment Configuration
# Copy this file to .env and fill in your values.

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

DEPLOYMENT_NETWORK=coston2
CHAIN_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
COSTON2_RPC=https://coston2-api.flare.network/ext/C/rpc
FLARE_COSTON2_RPC=https://coston2.enosys.global/ext/C/rpc
RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Agent wallet private key (required for executing transactions)
# WARNING: Never commit real private keys to version control.
AGENT_PRIVATE_KEY=

# =============================================================================
# AI CONFIGURATION
# =============================================================================

# Qwen API key (for AI explanations)
# Qwen DashScope-compatible API configuration
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MAX_MODEL=qwen-max
QWEN_TURBO_MODEL=qwen-turbo
QWEN_EMBED_MODEL=text-embedding-v2
QWEN_MAX_TOKENS=300
QWEN_TIMEOUT_MS=30000
QWEN_MAINTENANCE_TIMEOUT_MS=20000
QWEN_MAX_CALLS_PER_MINUTE=30

# WebSocket server port
WS_PORT=8080

# WebSocket authentication token (optional; leave empty for development)
WS_AUTH_TOKEN=

# =============================================================================
# CONTRACT ADDRESSES - FLARE COSTON2 (Chain ID: 114)
# =============================================================================

# The agent auto-loads deployed addresses from contracts/deployments/coston2.json.
# Use these only when deploying the agent without the manifest file available.
INVOICE_NFT_ADDRESS=0x7481aeE59C35bb08c4F4B0DC4DE0C0A143c9d7b7
YIELD_VAULT_ADDRESS=0xfDa39D8a75391aAec43BB54a774bf6F03A0033b6
AGENT_ROUTER_ADDRESS=0x95116249980028E240403477E41dF44e12968AC5
PRIVACY_REGISTRY_ADDRESS=0xc08B41ACeD118665d08b9517c812db483245791C
MOCK_ORACLE_ADDRESS=
FTSO_ORACLE_ADDRESS=0xCc351f611b89607e25ab124D3abF58A83ADf94a9
RISK_ORACLE_ADDRESS=
FTSO_V2_ADDRESS=0xC4e9c78EA53db782E28f28Fdf80BaF59336B304d
FTSO_ETH_USD_FEED_ID=0x014554482f55534400000000000000000000000000
FTSO_NATIVE_USD_FEED_ID=0x01464c522f55534400000000000000000000000000
AAVE_YIELD_ADDRESS=

# =============================================================================
# FLARE CONFIDENTIAL COMPUTE / FDC
# =============================================================================

FCE_TEE_MODE=true
FLARE_CHAIN_ID=114
FLARE_TEE_ID=
FLARE_FCE_IDENTITY_KEY=
# Local demos only. Leave false/blank for production FCE deployments.
ALLOW_INSECURE_FCE_KEY_FALLBACK=false
FCE_IMAGE_HASH=0x7f83b1657ff1fc53b92dc18148a1d65dfc2d4b1fa3d677284addd200126d9069
# Official Flare FCC extension stack. Fill from Flare Coston2 FCC deployed-addresses.json / extension setup.
TEE_EXTENSION_REGISTRY_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
TEE_MACHINE_REGISTRY_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
FCC_INSTRUCTION_SENDER_ADDRESS=0x6Aa62B3979D4cdc6E3A84772d66dC45adA047CaB
FCC_EXT_PROXY_URL=
EXT_PROXY_URL=
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
LOCAL_MODE=false
SIMULATED_TEE=true
# Flare official protocol registry. Same address on Flare, Coston2, Songbird, and Coston.
FLARE_CONTRACT_REGISTRY_ADDRESS=0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019
TEE_EXTENSION_REGISTRY_NAME=TeeExtensionRegistry
TEE_MACHINE_REGISTRY_NAME=TeeMachineRegistry
FLARE_TEE_MANAGER_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE
MOCK_FDC_VERIFIER_ADDRESS=0x4FE685b35c3A1B9b297eF7D1465C49b5d859daE9